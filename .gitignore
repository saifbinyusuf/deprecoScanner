# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Type checker & testing caches
.mypy_cache/
.pyright/
.pytest_cache/
.coverage
htmlcov/

# Logs & temp
*.log

# Large benchmark data & raw downloads
data/raw/*
!data/raw/llm-dep-api/
!data/raw/llm-dep-api/.gitkeep
data/raw/llm-dep-api/*
!data/raw/llm-dep-api/.gitkeep

# External cloned repos (keep directory, ignore contents)
external/*
!external/.gitkeep

# Historical benchmark library source trees (unpacked, keep stubs and gitkeep)
data/benchmark_libs/*
!data/benchmark_libs/.gitkeep
!data/benchmark_libs/stubs/
!data/benchmark_libs/stubs/**

# APIScanner baseline downloads
data/apiscanner_baseline/*
!data/apiscanner_baseline/.gitkeep

